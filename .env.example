# Knee angle (degrees) at/above which you're considered fully standing.
SQUAT_STANDING_ANGLE_DEG=160
# Knee angle (degrees) at/below which you're considered at the bottom of the
# squat. Lower = deeper squat required before a rep counts. 90 is a full
# below-parallel squat; if reps aren't being detected, watch the live "Knee
# angle" readout at your lowest point and raise this toward that value.
SQUAT_BOTTOM_ANGLE_DEG=110
